# Servidor Backend
PORT=3001
PUBLIC_WEB_URL=http://localhost:5173

# Base de datos MySQL local (XAMPP / phpMyAdmin por defecto)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
