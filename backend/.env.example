# Proveedor de WhatsApp por defecto: simulator | wame | baileys | meta_cloud
WHATSAPP_DEFAULT_PROVIDER=simulator

# (Opcional) Solo si utilizas la API oficial de Meta WhatsApp Cloud
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0
